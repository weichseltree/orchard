# Optional services. The local grove demo, portfolio and bundle verification
# need none of these values. Fill only the groups you use.
#
# Store the real file at ~/.config/orchard/secrets.env with mode 600.
# ORCHARD_SECRETS selects another path; process environment values take priority.
# The legacy ~/.config/ptstudio/secrets.env is a fallback.
# Never commit real values or put server secrets in VITE_* variables.
# Run `uv run orchard doctor` to report missing variable names, never values.
# Service registry: services.yaml. Hosting setup: docs/HOSTING.md.

# Cloudflare Pages deployment. R2 and infrastructure operations can use their
# own scoped tokens below; see docs/HOSTING.md for permissions and setup.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# R2 media uploads (`orchard push`, `orchard exhibit hang`).
# Falls back to CLOUDFLARE_API_TOKEN when omitted.
CLOUDFLARE_R2_TOKEN=

# Infrastructure setup (`orchard r2 ensure`, Turnstile setup).
# Falls back to CLOUDFLARE_API_TOKEN when omitted; prefer a short-lived token.
CLOUDFLARE_ADMIN_TOKEN=

# Visitor token service, server-side only. Generate with
# `uv run orchard auth keygen --write`; follow docs/SECURITY.md for setup.
AUTH_SIGNING_KEY=
AUTH_NETWORK_KEY=

# Human check for the hosted token service. SITEKEY is public;
# TURNSTILE_SECRET stays on the server. Neither is needed by `pnpm demo`.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Planned spatial voice service; configuring these does not enable voice yet.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# Optional studio services. The shared studio is still being built;
# these names are the service registry, not demo prerequisites.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PEXELS_API_KEY=
NASA_API_KEY=

# YouTube publishing integration (planned). Publication needs a host ruling.
YOUTUBE_CLIENT_SECRETS=

# SpacetimeDB keeps its CLI login outside this file. Database selection uses
# process variables ORCHARD_DB, ORCHARD_SPACETIME_SERVER and, optionally,
# ORCHARD_SPACETIME_CONFIG. See docs/HOSTING.md and grove/README.md.
